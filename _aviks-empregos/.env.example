# Copie para .env e preencha. O .env NÃO vai para o GitHub.

# Chave da API do Claude: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Senha do painel (obrigatória para abrir no celular / fora deste computador)
SENHA_PAINEL=troque-esta-senha

# Avisos no celular: instale o app "ntfy" e assine este tópico (invente um nome difícil, ele funciona como senha)
NTFY_TOPICO=aviks-empregos-xxxxxxxxxxxx
# NTFY_SERVIDOR=https://ntfy.sh

# Endereço do painel (o aviso no celular abre este link ao tocar)
URL_PAINEL=http://localhost:3900

PORT=3900
FUSO=America/Sao_Paulo
# MODELO_CLAUDE=claude-opus-5-5
# 1 = mostra a janela do navegador enquanto o agente trabalha (bom para acompanhar as primeiras vezes)
NAVEGADOR_VISIVEL=0
