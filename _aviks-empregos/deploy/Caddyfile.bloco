# Colar no deploy/Caddyfile do repositório estetic-pro, ANTES do bloco "https://" (junto do painel.julianafelix.com.br).
# Aviks Empregos (contêiner aviks-empregos, em /opt/aviks-empregos).
empregos.aviks.com.br {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy aviks-empregos:3900
}
